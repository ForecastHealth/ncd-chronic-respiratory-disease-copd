{
  "schema": "forecast-health.disease-opening-state-contract.v3",
  "contract_id": "ncd-copd-opening-state",
  "module_id": "copd_epidemiology_core",
  "version": "v3",
  "reconciliation_module_id": "opening-state-reconciliation",
  "purpose": "Declare the copd rate calibration applied by the shared opening-state reconciliation.",
  "scenario_policy": {
    "inputs": "baseline_only",
    "comparison_intervention_inputs_allowed": false,
    "artifact_reuse": "same_content_hash_for_baseline_and_all_comparisons"
  },
  "rate_calibration": {
    "schema": "forecast-health.disease-rate-calibration.v1",
    "method_id": "attributed_cause_specific_death_fit.v1",
    "authorization": {
      "status": "authorized",
      "recorded_date": "2026-10-05",
      "authority": "Rory Watts and Robert Totanes (WHO) approved disease-model calibration. Rory delegated the method decisions of 5 October 2026 to the team lead, who adopted WHO GHE 2021 cause-specific deaths as the death target, a 28-day per-episode reading of acute case fatality with acute deaths capped at half of target deaths, and cohort-consistent opening complication shares.",
      "scope": "Opening-year attributed deaths, and stationary prevalence through declared remission or other-cause relative mortality fits."
    },
    "states": [
      "DsFreeSus",
      "COPDEpsd"
    ],
    "residual_state": "DsFreeSus",
    "rates": {
      "copd_incidence": {
        "source": {
          "data_type": "fhdb.epidemiology",
          "parameters": {
            "country": "$country",
            "disease": "COPD",
            "measure": "incidence",
            "min_age": 15
          }
        },
        "unit": "population_rate",
        "apply": "susceptible_incidence_scale"
      },
      "copd_fatality": {
        "source": {
          "data_type": "fhdb.epidemiology",
          "parameters": {
            "country": "$country",
            "disease": "COPD",
            "measure": "deaths"
          }
        },
        "unit": "annual_hazard",
        "upper_bound": 3.0,
        "runtime_binding": {
          "source_node_id": "lrso81aw"
        }
      }
    },
    "transitions": [
      {
        "from": "DsFreeSus",
        "to": "COPDEpsd",
        "rate": "copd_incidence"
      },
      {
        "from": "COPDEpsd",
        "to": null,
        "rate": "copd_fatality"
      }
    ],
    "causes": [
      {
        "cause_id": "copd",
        "target": {
          "source": {
            "data_type": "who_ghe.cause_death_rate",
            "parameters": {
              "country": "$country",
              "cause": "copd",
              "release": "GHE 2021"
            }
          },
          "unit": "deaths_per_person_repeated_over_band_ages",
          "age_bands": [
            [
              0,
              4
            ],
            [
              5,
              14
            ],
            [
              15,
              29
            ],
            [
              30,
              49
            ],
            [
              50,
              59
            ],
            [
              60,
              69
            ],
            [
              70,
              100
            ]
          ],
          "meaning": "WHO Global Health Estimates 2021 cause-specific deaths divided by population, by sex and GHE age band, applied to the opening population."
        },
        "age_shape": {
          "product_of": [
            {
              "data_type": "fhdb.epidemiology",
              "parameters": {
                "country": "$country",
                "disease": "COPD",
                "measure": "deaths"
              }
            },
            {
              "data_type": "fhdb.epidemiology",
              "parameters": {
                "country": "$country",
                "disease": "COPD",
                "measure": "prevalence",
                "min_age": 15
              }
            }
          ]
        },
        "attributed_death_rates": {
          "copd_fatality": 1
        },
        "fitted_rates": [
          "copd_fatality"
        ]
      }
    ],
    "assumptions": [
      "The COPD fatality input is scaled by sex and age so year-one COPD deaths equal WHO GHE 2021 COPD deaths.",
      "Other-cause deaths are the demographic all-cause deaths less this disease's deaths. The annual rebase removes them from each state in proportion to its size times its fitted other-cause relative mortality, which is 1 for the disease-free state."
    ],
    "other_cause_relative_mortality": {
      "all_cause_probability_source": {
        "data_type": "fhdb.mortality",
        "parameters": {
          "country": "$country"
        }
      },
      "groups": [
        {
          "group_id": "copd",
          "states": [
            "COPDEpsd"
          ],
          "prevalent_states": [
            "COPDEpsd"
          ]
        }
      ],
      "age_bands": [
        [
          0,
          4
        ],
        [
          5,
          9
        ],
        [
          10,
          14
        ],
        [
          15,
          19
        ],
        [
          20,
          24
        ],
        [
          25,
          29
        ],
        [
          30,
          39
        ],
        [
          40,
          49
        ],
        [
          50,
          59
        ],
        [
          60,
          69
        ],
        [
          70,
          79
        ],
        [
          80,
          100
        ]
      ],
      "bounds": [
        1.0,
        4.0
      ],
      "meaning": "Fitted by GBD age band, within 1 to 4, so the year's transitions and the annual rebase carry observed prevalence forward unchanged. People with the disease die of other causes at this multiple of the partition's other-cause rate; these deaths are not attributed to the disease."
    }
  }
}
