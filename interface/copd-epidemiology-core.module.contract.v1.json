{
  "schema": "botech.module-contract.v1",
  "module_id": "copd_epidemiology_core",
  "module_type": "disease_epidemiology",
  "owner": {
    "repo_id": "ncd-copd",
    "repo_ref": "/Users/rory/Models/ncd-copd"
  },
  "version": "v1",
  "runtime_role": "compiled_together",
  "owned_parameters": [],
  "declared_inputs": [
    {
      "channel_id": "population_at_risk_opening",
      "meaning": "Opening COPD-local population at risk, seeded from the demographic substrate and COPD prevalence.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "owner_module_id": "demographic_substrate"
    },
    {
      "channel_id": "background_mortality_rate",
      "meaning": "All-cause background mortality rate supplied by the demographic substrate.",
      "shape": "2x101",
      "units": "rate",
      "required": true,
      "owner_module_id": "demographic_substrate",
      "binding": {
        "legacy_lowering_ref": "$.links[?(@.id=='cz2LeDKw')].compiler_binding"
      }
    },
    {
      "channel_id": "incidence_modifier",
      "meaning": "Optional source-owned risk-factor modifier applied to COPD incidence.",
      "shape": "yearly_2x101_or_scalar",
      "units": "multiplier",
      "required": false,
      "binding": {
        "legacy_lowering_ref": "$.links[?(@.id=='uSWdM5kH')].compiler_binding"
      }
    }
  ],
  "published_outputs": [
    {
      "channel_id": "copd_episode_population",
      "meaning": "People currently in the COPD episode state.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "binding": {
        "node_id": "COPDEpsd"
      }
    },
    {
      "channel_id": "copd_incidence_flow",
      "meaning": "New COPD episode flow.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "binding": {
        "node_id": "cXtHHFW2"
      }
    },
    {
      "channel_id": "copd_mortality_flow",
      "meaning": "COPD-specific mortality flow.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "binding": {
        "node_id": "lrstce6u"
      }
    },
    {
      "channel_id": "copd_dalys",
      "meaning": "COPD disability-adjusted life years metric.",
      "shape": "yearly_scalar_or_2x101",
      "units": "years",
      "required": false,
      "binding": {
        "node_id": "igyhM1ma"
      }
    }
  ],
  "state_initialization": {
    "mode": "solver_required",
    "recipe_ref": "data/copd-opening-balance-seed.recipe.v1.json",
    "targets": [
      "COPDEpsd"
    ]
  },
  "runtime_data_requirements": [
    {
      "data_type": "epidemiology",
      "parameters": {
        "country": "ISO3",
        "disease": "COPD",
        "measure": "prevalence"
      },
      "required_for": [
        "state_initialization"
      ]
    },
    {
      "data_type": "epidemiology",
      "parameters": {
        "country": "ISO3",
        "disease": "COPD",
        "measure": "incidence"
      },
      "required_for": [
        "copd_incidence_flow"
      ]
    },
    {
      "data_type": "epidemiology",
      "parameters": {
        "country": "ISO3",
        "disease": "COPD",
        "measure": "deaths"
      },
      "required_for": [
        "copd_mortality_flow"
      ]
    },
    {
      "data_type": "copd.get_observation",
      "parameters": {
        "country": "ISO3",
        "observation": "COPDEpsd -> Disability"
      },
      "required_for": [
        "copd_disability_weight"
      ]
    },
    {
      "data_type": "healthy_disability",
      "parameters": {
        "country": "ISO3"
      },
      "required_for": [
        "healthy_years_lived"
      ]
    },
    {
      "data_type": "yll_weights",
      "parameters": {},
      "required_for": [
        "years_of_life_lost"
      ]
    }
  ],
  "cards": {},
  "provenance": {
    "default_sources": [
      {
        "source_id": "spectrum_onehealth_copd",
        "use": "COPD epidemiology defaults"
      },
      {
        "source_id": "current_module_cleanup",
        "use": "Contract-era COPD module surface cleanup and intervention extraction"
      }
    ],
    "unresolved": []
  },
  "validation": {
    "internal_validity_tests": [
      "python scripts/validate_module_contract.py"
    ],
    "face_validity_checks": []
  },
  "intervention_extension_points": [
    {
      "channel_id": "copd_disability_effect_transform",
      "meaning": "Target-side transform node where component-owned COPD clinical intervention disability effects are multiplied into the COPD disability weight.",
      "endpoint_role": "target",
      "node_id": "lrwz1ikj",
      "shape": "scalar",
      "units": "proportion",
      "binding": {
        "node_id": "lrwz1ikj"
      }
    }
  ]
}
