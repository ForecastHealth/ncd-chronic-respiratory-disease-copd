{
  "schema": "botech.module-contract.v1",
  "module_id": "copd_epidemiology_core",
  "module_type": "disease_epidemiology",
  "owner": {
    "repo_id": "ncd-copd",
    "repo_ref": "ncd-copd"
  },
  "version": "v1",
  "runtime_role": "compiled_together",
  "owned_parameters": [],
  "declared_inputs": [
    {
      "channel_id": "population_at_risk_opening",
      "meaning": "COPD-local population at risk derived at each model-year opening from the canonical population and the declared COPD state.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "owner_module_id": "demographic_substrate"
    },
    {
      "channel_id": "background_mortality_rate",
      "meaning": "All-cause background mortality rate supplied by the demographic substrate.",
      "shape": "2x101",
      "units": "rate",
      "required": true,
      "owner_module_id": "demographic_substrate",
      "binding": {
        "legacy_lowering_ref": "$.links[?(@.id=='cz2LeDKw')].compiler_binding"
      }
    },
    {
      "channel_id": "incidence_modifier",
      "meaning": "Optional source-owned risk-factor modifier applied to COPD incidence.",
      "shape": "yearly_2x101_or_scalar",
      "units": "multiplier",
      "required": false,
      "binding": {
        "legacy_lowering_ref": "$.links[?(@.id=='uSWdM5kH')].compiler_binding"
      }
    }
  ],
  "published_outputs": [
    {
      "channel_id": "copd_episode_population",
      "meaning": "People currently in the COPD episode state.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "binding": {
        "node_id": "COPDEpsd"
      }
    },
    {
      "channel_id": "copd_incidence_flow",
      "meaning": "New COPD episode flow.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "binding": {
        "edge_id": "compiler::copd::incidence_from_disease_free_population"
      }
    },
    {
      "channel_id": "copd_mortality_flow",
      "meaning": "COPD-specific mortality flow.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "binding": {
        "edge_id": "XNyqqSsC"
      }
    }
  ],
  "marginal_disease_process": {
    "schema": "forecast-health.marginal-disease-process.v1",
    "population_semantics": "non_additive_marginal_estimate",
    "main_population_owner_module_id": "demographic_substrate",
    "population_partition": {
      "semantics": "mutually_exclusive_exhaustive",
      "living_state_node_ids": [
        "DsFreeSus",
        "COPDEpsd"
      ],
      "residual_state_node_id": "DsFreeSus",
      "residual_state_semantics": {
        "classification": "derived_population_at_risk",
        "authoritative_population": false,
        "meaning": "People in the canonical population who are not in the declared COPD state in this marginal disease process.",
        "opening_calculation": "canonical_population_minus_declared_non_residual_states",
        "annual_calculation": "At each model-year opening, canonical population minus the declared non-residual COPD states, by age and sex"
      }
    },
    "cause_specific_mortality": {
      "excludes_demographic_background_mortality": true,
      "units": "deaths",
      "output_link_ids": [
        "XNyqqSsC"
      ],
      "output_semantics": "Values emitted by the Botech EDGE_VALUES_CALCULATED events for these links are actual cause-specific death flows. Case-fatality helper nodes are not mortality outputs."
    },
    "morbidity": {
      "metric_input_contract_ref": "interface/copd-epidemiology-core.metric-inputs.v1.json",
      "aggregation_semantics": "comparison_minus_baseline_yld_rate"
    }
  },
  "state_initialization": {
    "mode": "opening_state_reconciliation_required",
    "reconciliation_module_id": "opening-state-reconciliation",
    "recipe_ref": "data/copd-opening-balance-seed.recipe.v1.json",
    "scenario_policy": "one_baseline_only_artifact_shared_by_baseline_and_comparison",
    "targets": [
      "DsFreeSus",
      "COPDEpsd"
    ]
  },
  "runtime_data_requirements": [
    {
      "data_type": "epidemiology",
      "parameters": {
        "country": "ISO3",
        "disease": "COPD",
        "measure": "prevalence"
      },
      "required_for": [
        "state_initialization"
      ]
    },
    {
      "data_type": "epidemiology",
      "parameters": {
        "country": "ISO3",
        "disease": "COPD",
        "measure": "incidence"
      },
      "required_for": [
        "copd_incidence_flow"
      ]
    },
    {
      "data_type": "epidemiology",
      "parameters": {
        "country": "ISO3",
        "disease": "COPD",
        "measure": "deaths"
      },
      "required_for": [
        "copd_mortality_flow"
      ]
    },
    {
      "data_type": "copd.get_observation",
      "parameters": {
        "country": "ISO3",
        "observation": "COPDEpsd -> Disability"
      },
      "required_for": [
        "copd_disability_weight"
      ]
    },
    {
      "data_type": "healthy_disability",
      "parameters": {
        "country": "ISO3"
      },
      "required_for": [
        "healthy_years_lived"
      ]
    },
    {
      "data_type": "yll_weights",
      "parameters": {},
      "required_for": [
        "years_of_life_lost"
      ]
    }
  ],
  "cards": {},
  "provenance": {
    "default_sources": [
      {
        "source_id": "spectrum_onehealth_copd",
        "use": "COPD epidemiology defaults"
      },
      {
        "source_id": "current_module_cleanup",
        "use": "Contract-era COPD module surface cleanup and intervention extraction"
      }
    ],
    "unresolved": []
  },
  "runtime_transition_semantics": {
    "schema": "forecast-health.botech-runtime-transition-semantics.v1",
    "default_remove_value_from_source": true,
    "phases": [
      {
        "phase_id": "main_disease_transitions",
        "subroutine_narration": "Main Routine",
        "allocation_basis": "phase_opening_balance",
        "method": "continuous_hazard_transition_system",
        "source_removing_link_ids": [
          "XNyqqSsC"
        ]
      },
      {
        "phase_id": "background_mortality",
        "subroutine_narration": "Background Mortality",
        "allocation_basis": "current_balance_after_prior_phases",
        "method": "sequential_transfer",
        "source_removing_link_ids": [
          "cz2LeDKw"
        ]
      }
    ],
    "semantic_rules": [
      "The disease transition system calculates competing disease flows from one phase-opening balance.",
      "Background mortality is applied after the disease transition system to the balance left in each living state.",
      "File order and link order do not change competing disease-transition results."
    ]
  },
  "compiler_composition": {
    "schema": "forecast-health.botech-disease-composition.v1",
    "target_key": "copd",
    "model_slug": "ncd-copd",
    "label": "COPD",
    "baseline_template_id": "copd_baseline",
    "permitted_comparison_template_ids": [
      "copd_baseline"
    ],
    "materializer": {
      "command_ref": "scripts/orchestrator_scenarios.py",
      "model_output_ref": "model.json"
    },
    "lowering_profile": "partitioned_disease_v1",
    "lowering": {
      "data_fetcher_label": "copd",
      "prevalence_inputs": {
        "copd_prevalence": {
          "data_fetcher_label": "fhdb",
          "method": "epidemiology",
          "parameters": {
            "disease": "COPD",
            "measure": "prevalence"
          }
        }
      },
      "incidence_edges": [
        {
          "id": "compiler::copd::incidence_from_disease_free_population",
          "label": "COPD incidence from disease-free population",
          "target_surrogate": "cXtHHFW2",
          "target_state": "COPDEpsd",
          "target_transition_edge_id": "2jjgV7Dx"
        }
      ],
      "disable_subroutine_edges": [
        "2jjgV7Dx"
      ],
      "background_mortality_edges": [
        "cz2LeDKw"
      ],
      "age_states": [
        "COPDEpsd"
      ],
      "migration_state_node_ids": [
        "COPDEpsd"
      ],
      "living_state_nodes": [
        "DsFreeSus",
        "COPDEpsd"
      ],
      "headline_nodes": {
        "Disease-free population": "DsFreeSus",
        "COPD episode population": "COPDEpsd"
      }
    }
  },
  "validation": {
    "internal_validity_tests": [
      "python scripts/validate_module_contract.py"
    ],
    "face_validity_checks": []
  },
  "intervention_extension_points": [
    {
      "channel_id": "copd_disability_effect_transform",
      "meaning": "Target-side transform node where component-owned COPD clinical intervention disability effects are multiplied into the COPD disability weight.",
      "endpoint_role": "target",
      "node_id": "lrwz1ikj",
      "shape": "scalar",
      "units": "proportion",
      "binding": {
        "node_id": "lrwz1ikj"
      },
      "composition_semantics": {
        "combination_rule": "additive_disability_reduction_contributions",
        "neutral_value": 1,
        "selection_guard": "Only explicitly selected COPD intervention components contribute to the shared disability transform."
      }
    }
  ],
  "implementation_notes": [
    "HYL, YLL, YLD and DALY calculations are owned by metric modules, not by this disease graph. This disease module publishes raw disease rows needed by those metric modules."
  ]
}
