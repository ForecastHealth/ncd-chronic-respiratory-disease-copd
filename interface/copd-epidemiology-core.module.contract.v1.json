{
  "schema": "botech.module-contract.v1",
  "module_id": "copd_epidemiology_core",
  "module_type": "disease_epidemiology",
  "owner": {
    "repo_id": "ncd-copd",
    "repo_ref": "/Users/rory/Models/ncd-copd"
  },
  "version": "v1",
  "runtime_role": "compiled_together",
  "owned_parameters": [],
  "declared_inputs": [
    {
      "channel_id": "population_at_risk_opening",
      "meaning": "Opening COPD-local population at risk, seeded from the demographic substrate and COPD prevalence.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "owner_module_id": "demographic_substrate"
    },
    {
      "channel_id": "background_mortality_rate",
      "meaning": "All-cause background mortality rate supplied by the demographic substrate.",
      "shape": "2x101",
      "units": "rate",
      "required": true,
      "owner_module_id": "demographic_substrate",
      "binding": {
        "legacy_lowering_ref": "$.links[?(@.id=='cz2LeDKw')].compiler_binding"
      }
    },
    {
      "channel_id": "incidence_modifier",
      "meaning": "Optional source-owned risk-factor modifier applied to COPD incidence.",
      "shape": "yearly_2x101_or_scalar",
      "units": "multiplier",
      "required": false,
      "binding": {
        "legacy_lowering_ref": "$.links[?(@.id=='uSWdM5kH')].compiler_binding"
      }
    }
  ],
  "published_outputs": [
    {
      "channel_id": "copd_episode_population",
      "meaning": "People currently in the COPD episode state.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "binding": {
        "node_id": "COPDEpsd"
      }
    },
    {
      "channel_id": "copd_incidence_flow",
      "meaning": "New COPD episode flow.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "binding": {
        "node_id": "cXtHHFW2"
      }
    },
    {
      "channel_id": "copd_mortality_flow",
      "meaning": "COPD-specific mortality flow.",
      "shape": "2x101",
      "units": "people",
      "required": true,
      "binding": {
        "node_id": "lrstce6u"
      }
    }
  ],
  "marginal_disease_process": {
    "schema": "forecast-health.marginal-disease-process.v1",
    "population_semantics": "non_additive_marginal_estimate",
    "main_population_owner_module_id": "demographic_substrate",
    "cause_specific_mortality": {
      "excludes_demographic_background_mortality": true,
      "output_node_ids": [
        "lrstce6u"
      ],
      "units": "deaths"
    },
    "morbidity": {
      "metric_input_contract_ref": "interface/copd-epidemiology-core.metric-inputs.v1.json",
      "aggregation_semantics": "comparison_minus_baseline_yld_rate"
    }
  },
  "state_initialization": {
    "mode": "solver_required",
    "recipe_ref": "data/copd-opening-balance-seed.recipe.v1.json",
    "targets": [
      "COPDEpsd"
    ]
  },
  "runtime_data_requirements": [
    {
      "data_type": "epidemiology",
      "parameters": {
        "country": "ISO3",
        "disease": "COPD",
        "measure": "prevalence"
      },
      "required_for": [
        "state_initialization"
      ]
    },
    {
      "data_type": "epidemiology",
      "parameters": {
        "country": "ISO3",
        "disease": "COPD",
        "measure": "incidence"
      },
      "required_for": [
        "copd_incidence_flow"
      ]
    },
    {
      "data_type": "epidemiology",
      "parameters": {
        "country": "ISO3",
        "disease": "COPD",
        "measure": "deaths"
      },
      "required_for": [
        "copd_mortality_flow"
      ]
    },
    {
      "data_type": "copd.get_observation",
      "parameters": {
        "country": "ISO3",
        "observation": "COPDEpsd -> Disability"
      },
      "required_for": [
        "copd_disability_weight"
      ]
    },
    {
      "data_type": "healthy_disability",
      "parameters": {
        "country": "ISO3"
      },
      "required_for": [
        "healthy_years_lived"
      ]
    },
    {
      "data_type": "yll_weights",
      "parameters": {},
      "required_for": [
        "years_of_life_lost"
      ]
    }
  ],
  "cards": {},
  "provenance": {
    "default_sources": [
      {
        "source_id": "spectrum_onehealth_copd",
        "use": "COPD epidemiology defaults"
      },
      {
        "source_id": "current_module_cleanup",
        "use": "Contract-era COPD module surface cleanup and intervention extraction"
      }
    ],
    "unresolved": []
  },
  "compiler_composition": {
    "schema": "forecast-health.botech-disease-composition.v1",
    "target_key": "copd",
    "model_slug": "ncd-copd",
    "label": "COPD",
    "baseline_template_id": "copd_baseline",
    "permitted_comparison_template_ids": [
      "copd_baseline"
    ],
    "materializer": {
      "command_ref": "scripts/orchestrator_scenarios.py",
      "model_output_ref": "model.json"
    },
    "lowering_profile": "partitioned_disease_v1",
    "lowering": {
      "data_fetcher_label": "copd",
      "prevalence_inputs": {
        "copd_prevalence": {
          "data_fetcher_label": "fhdb",
          "method": "epidemiology",
          "parameters": {
            "disease": "COPD",
            "measure": "prevalence"
          }
        }
      },
      "incidence_edges": [
        {
          "id": "compiler::copd::incidence_from_disease_free_population",
          "label": "COPD incidence from disease-free population",
          "target_surrogate": "cXtHHFW2",
          "target_state": "COPDEpsd"
        }
      ],
      "disable_subroutine_edges": [
        "2jjgV7Dx"
      ],
      "background_mortality_edges": [
        "cz2LeDKw"
      ],
      "age_states": [
        "COPDEpsd"
      ],
      "birth_sources": [
        "DsFreeSus",
        "COPDEpsd"
      ],
      "living_state_nodes": [
        "DsFreeSus",
        "COPDEpsd"
      ],
      "headline_nodes": {
        "Disease-free population": "DsFreeSus",
        "COPD episode population": "COPDEpsd"
      }
    }
  },
  "validation": {
    "internal_validity_tests": [
      "python scripts/validate_module_contract.py"
    ],
    "face_validity_checks": []
  },
  "intervention_extension_points": [
    {
      "channel_id": "copd_disability_effect_transform",
      "meaning": "Target-side transform node where component-owned COPD clinical intervention disability effects are multiplied into the COPD disability weight.",
      "endpoint_role": "target",
      "node_id": "lrwz1ikj",
      "shape": "scalar",
      "units": "proportion",
      "binding": {
        "node_id": "lrwz1ikj"
      }
    }
  ],
  "implementation_notes": [
    "HYL, YLL, YLD and DALY calculations are owned by metric modules, not by this disease graph. This disease module publishes raw disease rows needed by those metric modules."
  ]
}
