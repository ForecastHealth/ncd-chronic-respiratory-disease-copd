                "note": "Disease-free population contributes no disease-specific YLD; healthy residual weight belongs to HYL, not health burden."
              }
            ]
          },
          {
            "output_label": "YLD-COPDEpsd",
            "state_inputs": [
              {
                "source_label": "COPDEpsd",
                "generator_kind": "runtime_output",
                "source_node_id": "COPDEpsd"
              }
            ],
            "disability_weight_inputs": [
              {
                "source_label": "COPD_Disability_Weight",
                "generator_kind": "runtime_output",
                "source_node_id": "lrso7mga"
              }
            ]
          }
        ],
        "yll": [
          {
            "output_label": "YLL-DsFreeSus",
            "death_inputs": [],
            "life_lost_weight_rule": []
